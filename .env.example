# Django 生产环境变量示例
# 复制为 .env.production 后填写真实值，不要把真实文件提交到 GitHub
DJANGO_SECRET_KEY=请替换为随机生成的长字符串
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=model.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://model.example.com
DJANGO_ACCESS_CODE=请替换为新的访问码

# PostgreSQL
POSTGRES_DB=weizhu
POSTGRES_USER=weizhu
POSTGRES_PASSWORD=请替换为强数据库密码
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Cloudflare Tunnel
CLOUDFLARE_TUNNEL_TOKEN=请替换为Cloudflare生成的Token
